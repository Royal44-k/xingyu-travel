+  .offerCard > a { justify-self: start; }
+  .emptyState,
+  .domainUnavailable { min-height: 230px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tabList button::after,
+  .summaryCard,
+  .guideCover img { transition: none; }
+  .summaryCard:hover { transform: none; }
+  .guideCard:hover .guideCover img { transform: none; }
+}
