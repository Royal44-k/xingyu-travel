+    expect(screen.getByText('报价可能已变化')).toBeInTheDocument();
+    expect(screen.getByText(/数据时间/)).toBeInTheDocument();
+    expect(screen.getByRole('link', { name: '重新比价' })).toHaveAttribute(
+      'href',
+      '/compare?kind=flight&destination=%E5%A4%A7%E7%90%86',
