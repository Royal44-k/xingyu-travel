+    expect(screen.getByText('1 条收藏报价')).toBeInTheDocument();
+    await user.click(screen.getByRole('tab', { name: '喜欢' }));
+    expect(screen.getByRole('link', { name: /把大理留给慢下来的人/ })).toHaveAttribute(
+      'href',
+      '/square/dali-slow-5d',
