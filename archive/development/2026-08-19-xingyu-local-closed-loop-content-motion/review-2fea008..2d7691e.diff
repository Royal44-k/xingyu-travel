+async function newPage(viewport, label, initScript) {
+  const context = await browser.newContext({
+    deviceScaleFactor: 1,
+    reducedMotion: 'no-preference',
+    viewport,
+  });
+  if (initScript) await context.addInitScript(initScript);
+  const page = await context.newPage();
+  observe(page, label);
+  return { context, page };
