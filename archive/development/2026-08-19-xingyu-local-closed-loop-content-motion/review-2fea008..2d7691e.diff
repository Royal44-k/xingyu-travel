+
+beforeEach(() => {
+  vi.useRealTimers();
+  window.localStorage.clear();
+  useTripStore.setState({ trips: {}, partnerIntents: {}, guardianPlans: {} });
+  useTripStoreHydration.setState({ hydrated: true, hydrationError: false });
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  window.localStorage.clear();
