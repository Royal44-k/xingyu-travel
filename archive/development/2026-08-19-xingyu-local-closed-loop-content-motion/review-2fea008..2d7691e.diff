+  .overviewColumns,
+  .tripGrid,
+  .guideGrid,
+  .safetyGrid { grid-template-columns: 1fr; }
+  .summaryCard { min-height: 105px; }
+  .offerCard { grid-template-columns: 1fr; gap: 16px; }
+  .offerPrice { text-align: left; }
+  .offerCard dl { grid-column: auto; }
+  .offerCard > a { justify-self: start; }
+  .emptyState,
+  .domainUnavailable { min-height: 230px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
