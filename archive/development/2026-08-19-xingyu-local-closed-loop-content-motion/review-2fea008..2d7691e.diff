+  .identityStats { grid-template-columns: repeat(2, 1fr); }
+  .identityStats > div { padding: 10px 12px; }
+  .identityStats > div:nth-child(3) { border-left: 0; }
+  .identityStats dd { font-size: 23px; }
+  .tabShell { width: calc(100% - 28px); padding-bottom: 70px; }
+  .tabList { gap: 28px; margin: 0 -14px; padding: 0 14px; }
+  .tabList button { min-height: 58px; }
+  .sectionHeading { align-items: flex-start; flex-direction: column; }
+  .sectionHeading > span { text-align: left; }
