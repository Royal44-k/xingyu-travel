+  await expect(page.getByRole('link', { name: '从攻略创建行程' })).toBeVisible();
+  await record(page, 'assistant-hydration-error', '/assistant?tripId=dali-slow-5d', '行程存储损坏：失败关闭、保留恢复入口');
+  await context.close();
+}
