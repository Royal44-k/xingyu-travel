+  transition: color 160ms ease;
+}
+
+.favoriteButton[aria-pressed='true'] {
+  color: #a94032;
+}
+
+.favoriteButton[data-just-liked='true'] svg {
+  animation: favorite-success-bounce 360ms ease-out;
+}
+
+.favoriteButton:disabled {
